{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "map",
    "updated_at",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "map": {
      "enum": [
        "global",
        "middle-east"
      ]
    },
    "updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wtnv-lab/oil-transport-maps/blob/main/docs/user-data.schema.json",
  "title": "Oil transport maps — user data",
  "description": "Feature IDs must be unique. Consecutive duplicate coordinates are rejected by the Python validator. Dates must be real calendar dates. This is a deliberately restricted GeoJSON profile.",
  "allOf": [
    {
      "if": {
        "properties": {
          "features": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "updated_at": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  ],
  "$defs": {
    "coordinate": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -85,
          "maximum": 85
        }
      ],
      "items": false
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "$ref": "#/$defs/coordinate"
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "LineString"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "source",
        "observed_on",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\uD800-\\uDFFF\\uFFFE\\uFFFF]+$"
        },
        "kind": {
          "enum": [
            "port",
            "route",
            "pipeline",
            "note"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\uD800-\\uDFFF\\uFFFE\\uFFFF]+$"
        },
        "observed_on": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "enum": [
            "confirmed",
            "reported",
            "hypothetical"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\uD800-\\uDFFF\\uFFFE\\uFFFF]+$"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "line_style": {
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "dashdot"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        },
        "arrows": {
          "type": "boolean"
        },
        "label": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "offset": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -5000,
                  "maximum": 5000
                },
                {
                  "type": "number",
                  "minimum": -5000,
                  "maximum": 5000
                }
              ],
              "items": false
            },
            "font_size": {
              "type": "number",
              "minimum": 18,
              "maximum": 30
            },
            "anchor": {
              "enum": [
                "start",
                "end"
              ]
            }
          }
        },
        "callout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offset",
            "width",
            "title",
            "lines"
          ],
          "properties": {
            "offset": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -5000,
                  "maximum": 5000
                },
                {
                  "type": "number",
                  "minimum": -5000,
                  "maximum": 5000
                }
              ],
              "items": false
            },
            "width": {
              "type": "number",
              "minimum": 200,
              "maximum": 800
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\uD800-\\uDFFF\\uFFFE\\uFFFF]+$"
            },
            "lines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\uD800-\\uDFFF\\uFFFE\\uFFFF]+$"
              }
            }
          }
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "properties",
        "geometry"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\uD800-\\uDFFF\\uFFFE\\uFFFF]+$"
        },
        "properties": {
          "$ref": "#/$defs/properties"
        },
        "geometry": {
          "oneOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "$ref": "#/$defs/line"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "properties": {
                "properties": {
                  "kind": {
                    "enum": [
                      "port",
                      "note"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "$ref": "#/$defs/point"
              }
            }
          },
          "else": {
            "properties": {
              "geometry": {
                "$ref": "#/$defs/line"
              }
            }
          }
        }
      ]
    }
  }
}
